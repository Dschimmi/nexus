{% if config('module_cookie_banner') %}
{# Token ID: 'consent_action' #}
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-modal="true" aria-labelledby="cookie-title" data-csrf="{{ csrf_token('consent_action') }}">
    {# 1. Titel (Visuell oben) #}
    <h3 id="cookie-title" class="cookie-banner__title">{{ 'cookie.title'|trans }}</h3>
    
    {# 2. Buttons (Im DOM hier für Fokus-Reihenfolge, visuell via CSS unten) #}
    <div class="cookie-banner__actions">
        {# JS-Funktion handleCookie() wird erwartet #}
        <button class="btn btn--outline" onclick="handleCookie(true)">{{ 'cookie.btn_accept'|trans }}</button>
        <button class="btn btn--outline" onclick="handleCookie(false)">{{ 'cookie.btn_essential'|trans }}</button>
    </div>

    {# 3. Text (Visuell in der Mitte) #}
    <div class="cookie-banner__text" id="cookie-text">
        <p class="u-mb-0">{{ 'cookie.text'|trans|raw }}</p>
    </div>
</div>
{% endif %}