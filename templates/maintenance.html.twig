<!DOCTYPE html>
{# Sprache dynamisch setzen #}
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'maintenance.title'|trans }} - {{ 'brand.name'|trans }}</title>
    <style nonce="{{ nonce }}">
        body { font-family: -apple-system, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f8f9fa; color: #333; }
        .box { text-align: center; max-width: 600px; padding: 2rem; }
        h1 { color: #152836; margin-bottom: 1rem; }
        p { line-height: 1.5; color: #666; }
    </style>
</head>
<body>
    <div class="box">
        <h1>{{ 'maintenance.title'|trans }}</h1>
        <p>{{ 'maintenance.text'|trans }}</p>
    </div>
</body>
</html>