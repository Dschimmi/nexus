{#
    Listenansicht der Dummy-Seiten.
    WCAG 2.1 AA Konform.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'admin.pages_list_title'|trans }} – {{ parent() }}{% endblock %}

{% block content %}
{# <link rel="stylesheet" href="{{ asset('css/admin.css') }}"> #}

<section class="card" aria-labelledby="pages-list-title">
    <div class="u-flex u-justify-between u-items-center u-mb-4">
        <h1 id="pages-list-title">{{ 'admin.pages_list_title'|trans }}</h1>
        <div class="u-flex u-gap-2">
            <a href="/admin" class="btn btn--outline btn--sm" aria-label="{{ 'action.back_to_dashboard'|trans|default('Back') }}">{{'action.back'|trans}}</a>
            <a href="/admin/pages/create" class="btn btn--primary btn--sm">
                {{ 'admin.pages_btn_create'|trans }}
            </a>
        </div>
    </div>

    <div>
        <form action="/admin/pages/delete" method="post" id="deleteForm">
            {% include 'partials/csrf_input.html.twig' with {'token_id': 'page_delete'} %}
            
            {% if pages is empty %}
                <div class="u-text-center u-text-muted u-mb-4">
                    {{ 'admin.pages_empty'|trans }}
                </div>
            {% else %}
                <table class="table">
                    <thead>
                        <tr>
                            <th class="table__col-check">
                                <label class="checkbox-label u-justify-center">
                                    <input type="checkbox" id="selectAll" class="u-cursor-pointer" aria-label="{{ 'action.select_all'|trans|default('Alle auswählen') }}">
                                </label>
                            </th>
                            <th>{{ 'admin.pages_col_title'|trans }}</th>
                            <th>{{ 'admin.pages_col_slug'|trans }}</th>
                            <th class="table__col-actions">Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for page in pages %}
                            <tr>
                                <td class="table__col-check">
                                    <label class="checkbox-label u-justify-center">
                                        <input type="checkbox" name="slugs[]" value="{{ page.slug }}" class="page-checkbox" aria-label="{{ 'action.select_item'|trans }} {{ page.title }}">
                                    </label>
                                </td>
                                <td class="u-font-bold">
                                    {{ page.title }}
                                </td>
                                <td class="u-text-muted u-font-mono">
                                    /{{ page.slug }}
                                </td>
                                <td class="table__col-actions">
                                    <a href="/{{ page.slug }}" target="_blank" class="btn btn--outline btn--sm" aria-label="{{ 'action.preview'|trans }} {{ page.title }}">
                                        Vorschau
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if pages is not empty %}
                <div class="u-mt-4">
                    <button type="submit" class="btn btn--danger" id="btn-delete-confirm" data-confirm-text="{{ 'admin.pages_confirm_delete'|trans|default('Wirklich löschen?') }}">
                        {{ 'admin.pages_btn_delete'|trans }}
                    </button>
                </div>
            {% endif %}
        </form>
    </div>
</section>
{% endblock %}